# Pantheon heartbeat — one check-in with the main Pi (see heartbeat.sh).
# Installed by scripts/install-kiosk.sh --server <main-pi>; run by the timer.

[Unit]
Description=Pantheon heartbeat (tells the main Pi this display is alive)

[Service]
Type=oneshot
TimeoutStartSec=30
ExecStart=@PANTHEON_HOME@/web/kiosk/heartbeat.sh
