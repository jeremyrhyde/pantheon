# Pantheon module registry. Copy to modules.yaml (gitignored; `make setup`
# does it) and edit per host. Each module is reached at
# http://<this-host>:$GATEWAY_PORT/<name>/ and runs as <name>.service from
# modules/<name>. After editing: `make service-install-all` (to add/remove
# units) or just `make gateway-config` (to re-route).
# icon: the app icon the home screen shows, relative to this repo.
modules:
  - name: apollo
    title: Apollo
    port: 8001
    icon: modules/apollo/frontend/public/icon-512.png
    enabled: true
  - name: hermes
    title: Hermes
    port: 8002
    icon: modules/hermes/frontend/public/icon-512.png
    enabled: true
  - name: hestia
    title: Hestia
    port: 8003
    icon: modules/hestia/frontend/public/icon-512.png
    enabled: true
  - name: pluto
    title: Pluto
    port: 8004
    icon: modules/pluto/web/icon-512.png
    enabled: false   # no web server yet
