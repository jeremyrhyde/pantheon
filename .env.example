# Pantheon environment overrides. Copy to `.env` (gitignored) and edit.
# Read by the server (config.py), the background service (it runs from the
# repo root, so .env is found), and the kiosk launcher (web/kiosk/start-kiosk.sh).

# --- Server (FastAPI) — all optional, defaults shown ----------------------
#HOST=0.0.0.0
# Pantheon's own app. On a full install it sits behind the gateway.
#PORT=8010
#LOG_LEVEL=info
#WEB_DIR=./web
#DB_PATH=./pantheon.db

# --- Gateway + modules ----------------------------------------------------
# Where Caddy listens: the one address every client and kiosk uses.
#GATEWAY_PORT=8000
# The module registry (copy modules.yaml.example).
#MODULES_CONFIG_PATH=./modules.yaml
# How long the home screen waits for each module's /health.
#MODULE_HEALTH_TIMEOUT_SECONDS=1.0

# --- Kiosk: which server the fullscreen Chromium points at ----------------
# Default is this machine (http://localhost:$PORT/ui/). Set an IP to point a
# display at a server elsewhere on the network.
#SERVER_IP_ADDRESS=192.168.1.50
# Full URL override (wins over SERVER_IP_ADDRESS).
#PANTHEON_UI_URL=http://192.168.1.50:8000/ui/
