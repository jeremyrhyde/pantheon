# Pantheon environment overrides. Copy to `.env` (gitignored) and edit.
# Read by the server (config.py), the background service (it runs from the
# repo root, so .env is found), and the kiosk launcher (web/kiosk/start-kiosk.sh).

# --- Server (FastAPI) — all optional, defaults shown ----------------------
#HOST=0.0.0.0
# Pantheon's own app. On a full install it sits behind the gateway.
#PORT=8010
#LOG_LEVEL=info
#WEB_DIR=./web
#DB_PATH=./pantheon.db

# --- Gateway + modules ----------------------------------------------------
# Where Caddy listens: the one address every client and kiosk uses.
#GATEWAY_PORT=8000
# The module registry (copy modules.yaml.example).
#MODULES_CONFIG_PATH=./modules.yaml
# How long the home screen waits for each module's /health.
#MODULE_HEALTH_TIMEOUT_SECONDS=1.0

# --- Kiosk: which server the fullscreen Chromium points at ----------------
# Default is the gateway on this machine (http://localhost:$GATEWAY_PORT/).
# `make kiosk-install MODULE=<m> SERVER=<ip>` writes kiosk.env, which overrides
# this file, setting KIOSK_MODULE / SERVER_IP_ADDRESS.
#SERVER_IP_ADDRESS=192.168.1.50
# Open one module instead of the home screen.
#KIOSK_MODULE=apollo
# Full URL override (wins over the two above).
#PANTHEON_UI_URL=http://192.168.1.50:8000/apollo/
# --- Status screen collectors (in memory; defaults shown) ------------------
#HOST_SAMPLE_SECONDS=3
#MODULE_POLL_SECONDS=10
#DEVICE_PING_SECONDS=60
# A device's heartbeat older than this counts as stale.
#HEARTBEAT_STALE_SECONDS=150
# How much sparkline history to keep.
#HISTORY_SECONDS=3600
# Edge devices to expect (copy devices.yaml.example).
#DEVICES_CONFIG_PATH=./devices.yaml
# Caddy's access log. Empty = $XDG_RUNTIME_DIR/pantheon/access.log (RAM),
# or ./build/access.log without a runtime dir.
#ACCESS_LOG_PATH=
# Set by systemd/logind; only change it to move the default access log.
#XDG_RUNTIME_DIR=
